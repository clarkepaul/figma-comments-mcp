{
  "name": "figma-comments-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that lets Claude read, understand, and act on comments in Figma and FigJam — the layer the official Figma Dev Mode MCP is missing.",
  "type": "module",
  "bin": {
    "figma-comments-mcp": "dist/index.js",
    "figma-comments-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Šimon Jůn <simonjun@simonjun.cz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junsimon/figma-comments-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/junsimon/figma-comments-mcp/issues"
  },
  "homepage": "https://github.com/junsimon/figma-comments-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:secrets": "vitest run no-secrets",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "mcp",
    "figma",
    "figjam",
    "comments",
    "claude",
    "design-review",
    "workshops",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
