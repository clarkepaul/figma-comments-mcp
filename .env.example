# Figma Personal Access Token.
# Create at: Figma -> Settings -> Security -> Personal access tokens
# Required scopes:
#   - file_comments:read   (read comments & reactions)
#   - file_content:read    (read node tree for enrichment + render images)
#   - file_comments:write  (only needed if FIGMA_ENABLE_WRITES=true)
FIGMA_TOKEN=

# Enable the write tools (reply_to_comment, react_to_comment, post_comment).
# Defaults to false. Even when true, each write defaults to dry_run preview;
# the caller must pass dry_run:false to actually mutate a shared file.
FIGMA_ENABLE_WRITES=false

# Optional: in-memory file-tree cache TTL in milliseconds (default 60000).
# FIGMA_TREE_TTL_MS=60000

# Optional: max node-tree depth fetched for pin enrichment (default 4).
# Bounds the file payload so large files don't drop the connection mid-download
# (UND_ERR_SOCKET / "terminated"). Set 0 for an unbounded fetch.
# FIGMA_TREE_DEPTH=4
